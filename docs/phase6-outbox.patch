diff --git a/Saham/Infrastructure/Outbox/NotificationOutboxStore.cs b/Saham/Infrastructure/Outbox/NotificationOutboxStore.cs
new file mode 100644
index 0000000..1ba7e45
--- /dev/null
+++ b/Saham/Infrastructure/Outbox/NotificationOutboxStore.cs
@@ -0,0 +1,183 @@
+using System;
+using System.Collections.Generic;
+using System.Data;
+using System.Data.Common;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace Saham.Infrastructure.Outbox;
+
+/* Phase 6 store over the existing notification queue (AppNotifications — one row = one channel +
+ * one recipient, unique per (EventKey, Channel, UserId) with NULLS NOT DISTINCT). Same algorithm as the
+ * package's PostgresOutboxStore, adapted to this table:
+ *   - claim ONE due row with FOR UPDATE SKIP LOCKED and a lease in database time; the attempt counts
+ *     at claim, so a worker that dies also uses an attempt;
+ *   - ack (Sent / Failed / Dead) only while this claim still owns an unexpired lease;
+ *   - an expired lease is claimed again; at the attempt limit it becomes Dead instead.
+ * Every call opens its own connection (autocommit statements): no transaction is held while the
+ * provider is called, and the request/UoW connection is never used. Times are UTC "timestamp without
+ * time zone" like the rest of the schema, hence clock_timestamp() AT TIME ZONE 'UTC'. */
+public sealed class NotificationOutboxStore : IOutboxStore
+{
+    public const string AggregateType = "Notification";
+    private const string DbNow = "(clock_timestamp() AT TIME ZONE 'UTC')";
+
+    private readonly Func<CancellationToken, Task<DbConnection>> _openConnection;
+    private readonly OutboxOptions _options;
+    private readonly Func<IReadOnlyList<DeadNotification>, Task>? _onDead;
+
+    public NotificationOutboxStore(Func<CancellationToken, Task<DbConnection>> openConnection, OutboxOptions options,
+        Func<IReadOnlyList<DeadNotification>, Task>? onDead = null)
+    {
+        _openConnection = openConnection ?? throw new ArgumentNullException(nameof(openConnection));
+        _options = options ?? throw new ArgumentNullException(nameof(options));
+        _options.Validate();
+        _onDead = onDead;
+    }
+
+    public async Task<OutboxClaim?> ClaimAsync(CancellationToken cancellationToken)
+    {
+        await using var connection = await _openConnection(cancellationToken);
+
+        // Exhausted rows (their last attempt failed while the worker died) are kept as Dead for review.
+        await using (var recovery = connection.CreateCommand())
+        {
+            recovery.CommandText = $"""
+                WITH exhausted AS (
+                    SELECT "Id" FROM "AppNotifications"
+                    WHERE "Attempts" >= @max_attempts
+                      AND ("Status" IN ('Queued', 'Failed')
+                        OR ("Status" = 'Processing' AND "LeaseUntil" <= {DbNow}))
+                    ORDER BY "Id" LIMIT 100 FOR UPDATE SKIP LOCKED)
+                UPDATE "AppNotifications" AS n
+                SET "Status" = 'Dead', "LeaseToken" = NULL, "LeaseUntil" = NULL,
+                    "LastError" = 'ATTEMPT_LIMIT_EXHAUSTED', "ConcurrencyStamp" = @stamp
+                FROM exhausted AS x WHERE n."Id" = x."Id"
+                RETURNING n."Id", n."Template", n."OrderId";
+                """;
+            Add(recovery, "max_attempts", _options.MaxAttempts, DbType.Int32);
+            Add(recovery, "stamp", NewStamp(), DbType.String);
+            await ReportDeadAsync(recovery, cancellationToken);
+        }
+
+        await using var command = connection.CreateCommand();
+        command.CommandText = $"""
+            WITH candidate AS (
+                SELECT "Id" FROM "AppNotifications"
+                WHERE "Attempts" < @max_attempts
+                  AND (("Status" IN ('Queued', 'Failed') AND "NextAttemptAt" <= {DbNow})
+                    OR ("Status" = 'Processing' AND "LeaseUntil" <= {DbNow}))
+                ORDER BY "HighPriority" DESC, "NextAttemptAt", "Id"
+                LIMIT 1 FOR UPDATE SKIP LOCKED)
+            UPDATE "AppNotifications" AS n
+            SET "Status" = 'Processing', "Attempts" = n."Attempts" + 1,
+                "LeaseToken" = @token, "LeaseUntil" = {DbNow} + @lease_ms * INTERVAL '1 millisecond',
+                "ConcurrencyStamp" = @stamp
+            FROM candidate AS c WHERE n."Id" = c."Id"
+            RETURNING n."Id", n."Attempts", n."EventKey", n."Template";
+            """;
+        var token = Guid.NewGuid();
+        Add(command, "token", token, DbType.Guid);
+        Add(command, "max_attempts", _options.MaxAttempts, DbType.Int32);
+        Add(command, "lease_ms", _options.LeaseDuration.TotalMilliseconds, DbType.Double);
+        Add(command, "stamp", NewStamp(), DbType.String);
+        await using var reader = await command.ExecuteReaderAsync(cancellationToken);
+        if (!await reader.ReadAsync(cancellationToken))
+        {
+            return null;
+        }
+
+        // Message.EventKey = the notification id: stable for this channel + recipient, so it is the
+        // provider idempotency key (one event can have several notifications, each with its own id).
+        var id = reader.GetGuid(0);
+        return new OutboxClaim(0, token, reader.GetInt32(1),
+            new OutboxMessage(id, reader.GetString(3), AggregateType, id.ToString(), "{}"));
+    }
+
+    public Task<bool> CompleteAsync(OutboxClaim claim, string? providerMessageId, CancellationToken cancellationToken) =>
+        UpdateOwnedAsync(claim, $"""
+            UPDATE "AppNotifications"
+            SET "Status" = 'Sent', "SentAt" = {DbNow}, "ProviderMessageId" = @provider_id,
+                "LeaseToken" = NULL, "LeaseUntil" = NULL, "LastError" = NULL, "ConcurrencyStamp" = @stamp
+            WHERE "Id" = @id AND "Status" = 'Processing' AND "LeaseToken" = @token AND "LeaseUntil" > {DbNow}
+            RETURNING "Id", "Template", "OrderId", "Status";
+            """, command => Add(command, "provider_id", (object?)Truncate(providerMessageId, 128) ?? DBNull.Value, DbType.String),
+            cancellationToken);
+
+    public Task<bool> FailAsync(OutboxClaim claim, bool permanent, TimeSpan delay, string safeErrorCode, CancellationToken cancellationToken)
+    {
+        if (delay < TimeSpan.Zero || delay > TimeSpan.FromDays(1))
+        {
+            throw new ArgumentOutOfRangeException(nameof(delay));
+        }
+
+        // The persisted attempt count decides the last attempt, not a value from the caller.
+        return UpdateOwnedAsync(claim, $"""
+            UPDATE "AppNotifications"
+            SET "Status" = CASE WHEN @permanent OR "Attempts" >= @max_attempts THEN 'Dead' ELSE 'Failed' END,
+                "NextAttemptAt" = {DbNow} + @delay_ms * INTERVAL '1 millisecond',
+                "LeaseToken" = NULL, "LeaseUntil" = NULL, "LastError" = @error, "ConcurrencyStamp" = @stamp
+            WHERE "Id" = @id AND "Status" = 'Processing' AND "LeaseToken" = @token AND "LeaseUntil" > {DbNow}
+            RETURNING "Id", "Template", "OrderId", "Status";
+            """, command =>
+            {
+                Add(command, "permanent", permanent, DbType.Boolean);
+                Add(command, "max_attempts", _options.MaxAttempts, DbType.Int32);
+                Add(command, "delay_ms", delay.TotalMilliseconds, DbType.Double);
+                Add(command, "error", Truncate(safeErrorCode, 120)!, DbType.String);
+            }, cancellationToken);
+    }
+
+    /* False = the lease was lost (expired or claimed again): an old worker never updates a newer claim. */
+    private async Task<bool> UpdateOwnedAsync(OutboxClaim claim, string sql, Action<DbCommand> configure, CancellationToken cancellationToken)
+    {
+        await using var connection = await _openConnection(cancellationToken);
+        await using var command = connection.CreateCommand();
+        command.CommandText = sql;
+        Add(command, "id", claim.Message.EventKey, DbType.Guid);
+        Add(command, "token", claim.LeaseToken, DbType.Guid);
+        Add(command, "stamp", NewStamp(), DbType.String);
+        configure(command);
+        return await ReportDeadAsync(command, cancellationToken) > 0;
+    }
+
+    /* Runs an UPDATE … RETURNING "Id", "Template", "OrderId"[, "Status"]; Dead rows go to the callback. */
+    private async Task<int> ReportDeadAsync(DbCommand command, CancellationToken cancellationToken)
+    {
+        var dead = new List<DeadNotification>();
+        var rows = 0;
+        await using (var reader = await command.ExecuteReaderAsync(cancellationToken))
+        {
+            while (await reader.ReadAsync(cancellationToken))
+            {
+                rows++;
+                if (reader.FieldCount < 4 || reader.GetString(3) == "Dead")
+                {
+                    dead.Add(new DeadNotification(reader.GetGuid(0), reader.GetString(1), reader.IsDBNull(2) ? null : reader.GetGuid(2)));
+                }
+            }
+        }
+
+        if (dead.Count > 0 && _onDead != null)
+        {
+            await _onDead(dead);
+        }
+
+        return rows;
+    }
+
+    private static void Add(DbCommand command, string name, object value, DbType type)
+    {
+        var parameter = command.CreateParameter();
+        parameter.ParameterName = name;
+        parameter.DbType = type;
+        parameter.Value = value;
+        command.Parameters.Add(parameter);
+    }
+
+    private static string NewStamp() => Guid.NewGuid().ToString("N");
+
+    private static string? Truncate(string? value, int max) => value == null || value.Length <= max ? value : value[..max];
+}
+
+public sealed record DeadNotification(Guid Id, string Template, Guid? OrderId);
diff --git a/Saham/Infrastructure/Outbox/NotificationQueue.cs b/Saham/Infrastructure/Outbox/NotificationQueue.cs
new file mode 100644
index 0000000..5d16b34
--- /dev/null
+++ b/Saham/Infrastructure/Outbox/NotificationQueue.cs
@@ -0,0 +1,128 @@
+using System;
+using System.Collections.Generic;
+using System.Data.Common;
+using System.Threading;
+using System.Threading.Tasks;
+using Npgsql;
+using Saham.Entities.Notifications;
+using Saham.Entities.Support;
+using Saham.Settings;
+using Volo.Abp.Data;
+using Volo.Abp.DependencyInjection;
+using Volo.Abp.Domain.Repositories;
+using Volo.Abp.Settings;
+using Volo.Abp.Uow;
+
+namespace Saham.Infrastructure.Outbox;
+
+/* Wires the Phase 6 engine to the project: OutboxOptions from settings (operational defaults, not
+ * business rules), a NEW Npgsql connection per store call (never the request's), the real
+ * NotificationSender, and the delivery-code incident when such an SMS ends Dead (REQ-NTF-02). */
+public class NotificationQueue : ITransientDependency
+{
+    private readonly ISettingProvider _settingProvider;
+    private readonly IConnectionStringResolver _connectionStrings;
+    private readonly NotificationSender _sender;
+    private readonly IUnitOfWorkManager _unitOfWorkManager;
+    private readonly IncidentManager _incidentManager;
+    private readonly IRepository<Entities.Orders.Order, Guid> _orderRepository;
+
+    public NotificationQueue(
+        ISettingProvider settingProvider,
+        IConnectionStringResolver connectionStrings,
+        NotificationSender sender,
+        IUnitOfWorkManager unitOfWorkManager,
+        IncidentManager incidentManager,
+        IRepository<Entities.Orders.Order, Guid> orderRepository)
+    {
+        _settingProvider = settingProvider;
+        _connectionStrings = connectionStrings;
+        _sender = sender;
+        _unitOfWorkManager = unitOfWorkManager;
+        _incidentManager = incidentManager;
+        _orderRepository = orderRepository;
+    }
+
+    public async Task<OutboxOptions> GetOptionsAsync()
+    {
+        var options = new OutboxOptions
+        {
+            MaxAttempts = await _settingProvider.GetAsync<int>(SahamSettings.Notifications.MaxAttempts),
+            InitialRetryDelay = TimeSpan.FromSeconds(await _settingProvider.GetAsync<int>(SahamSettings.Notifications.RetryBaseSeconds)),
+            MaximumRetryDelay = TimeSpan.FromSeconds(await _settingProvider.GetAsync<int>(SahamSettings.Notifications.MaxRetryDelaySeconds)),
+            LeaseDuration = TimeSpan.FromSeconds(await _settingProvider.GetAsync<int>(SahamSettings.Notifications.LeaseSeconds)),
+            SendTimeout = TimeSpan.FromSeconds(await _settingProvider.GetAsync<int>(SahamSettings.Notifications.SendTimeoutSeconds))
+        };
+        options.Validate(); // fails loudly on a bad configuration
+        return options;
+    }
+
+    public async Task<NotificationOutboxStore> CreateStoreAsync(OutboxOptions options)
+    {
+        var connectionString = await _connectionStrings.ResolveAsync();
+        return new NotificationOutboxStore(async ct =>
+        {
+            var connection = new NpgsqlConnection(connectionString);
+            await connection.OpenAsync(ct);
+            return (DbConnection)connection;
+        }, options, OnDeadAsync);
+    }
+
+    public async Task<OutboxRunResult> RunOnceAsync(int maximumMessages, CancellationToken cancellationToken)
+    {
+        var options = await GetOptionsAsync();
+        var processor = new OutboxProcessor(await CreateStoreAsync(options), _sender, options);
+        return await processor.RunOnceAsync(maximumMessages, cancellationToken);
+    }
+
+    private async Task OnDeadAsync(IReadOnlyList<DeadNotification> dead)
+    {
+        foreach (var n in dead)
+        {
+            if (n.Template != NotificationTemplates.DeliveryCode || !n.OrderId.HasValue)
+            {
+                continue;
+            }
+
+            // Ops read the code to the customer instead (REQ-NTF-02); OpenAsync deduplicates.
+            using var uow = _unitOfWorkManager.Begin(requiresNew: true, isTransactional: true);
+            var order = await _orderRepository.GetAsync(n.OrderId.Value, includeDetails: false);
+            await _incidentManager.OpenAsync(IncidentType.DeliveryCodeSmsFailed, IncidentSeverity.High, order.Id,
+                orderId: order.Id, restaurantId: order.RestaurantId);
+            await uow.CompleteAsync();
+        }
+    }
+}
+
+/* Last worker cycle, for the health endpoint (per process; each backend instance reports its own). */
+public class NotificationWorkerHealth : ISingletonDependency
+{
+    private readonly object _gate = new();
+
+    public DateTime? LastRunAt { get; private set; }
+    public DateTime? LastErrorAt { get; private set; }
+    public string? LastErrorCode { get; private set; }
+    public int ConsecutiveFailures { get; private set; }
+    public long LostLeases { get; private set; }
+
+    public void Succeeded(DateTime now, int lostLeases)
+    {
+        lock (_gate)
+        {
+            LastRunAt = now;
+            ConsecutiveFailures = 0;
+            LostLeases += lostLeases;
+        }
+    }
+
+    public void Failed(DateTime now, Exception error)
+    {
+        lock (_gate)
+        {
+            LastRunAt = now;
+            LastErrorAt = now;
+            LastErrorCode = error.GetType().Name; // the type only: messages may hold phone numbers or codes
+            ConsecutiveFailures++;
+        }
+    }
+}
diff --git a/Saham/Infrastructure/Outbox/OutboxDelivery.cs b/Saham/Infrastructure/Outbox/OutboxDelivery.cs
new file mode 100644
index 0000000..5616a88
--- /dev/null
+++ b/Saham/Infrastructure/Outbox/OutboxDelivery.cs
@@ -0,0 +1,177 @@
+using System.Data;
+using System.Data.Common;
+using System.Text.Json;
+
+namespace Saham.Infrastructure.Outbox;
+
+/* Phase 6 delivery engine from the package (policy + processor), unchanged in behaviour except:
+ * - DeliveryResult carries the provider message id and a safe error code (e.g. EXPIRED);
+ * - IOutboxStore.CompleteAsync receives that provider id.
+ * The store on the existing AppNotifications table is NotificationOutboxStore; the package's own
+ * PostgresOutboxStore / outbox_events reference schema is not used (one queue, no competing path). */
+public sealed record OutboxMessage(
+    Guid EventKey, string EventType, string AggregateType,
+    string AggregateId, string PayloadJson);
+
+public sealed record OutboxClaim(long Id, Guid LeaseToken, int Attempt, OutboxMessage Message);
+
+public sealed record OutboxOptions
+{
+    // Operational defaults, not business rules from the SRS.
+    public int MaxAttempts { get; init; } = 10;
+    public TimeSpan LeaseDuration { get; init; } = TimeSpan.FromSeconds(90);
+    public TimeSpan SendTimeout { get; init; } = TimeSpan.FromSeconds(20);
+    public TimeSpan InitialRetryDelay { get; init; } = TimeSpan.FromSeconds(5);
+    public TimeSpan MaximumRetryDelay { get; init; } = TimeSpan.FromMinutes(15);
+
+    public void Validate()
+    {
+        if (MaxAttempts is < 1 or > 1000)
+            throw new ArgumentOutOfRangeException(nameof(MaxAttempts));
+        if (SendTimeout <= TimeSpan.Zero || LeaseDuration <= SendTimeout + TimeSpan.FromSeconds(10)
+            || LeaseDuration > TimeSpan.FromDays(1))
+            throw new ArgumentException("Lease must exceed send timeout by more than 10 seconds and be at most one day.");
+        if (InitialRetryDelay <= TimeSpan.Zero || MaximumRetryDelay < InitialRetryDelay
+            || MaximumRetryDelay > TimeSpan.FromDays(1))
+            throw new ArgumentException("Invalid retry delay bounds.");
+    }
+}
+
+/// <summary>Exponential backoff with equal jitter: [half the cap, full cap].</summary>
+public static class OutboxRetryPolicy
+{
+    public static TimeSpan GetDelay(int failedAttempt, OutboxOptions options, double randomUnit)
+    {
+        ArgumentNullException.ThrowIfNull(options);
+        options.Validate();
+        if (failedAttempt < 1) throw new ArgumentOutOfRangeException(nameof(failedAttempt));
+        if (!double.IsFinite(randomUnit) || randomUnit < 0 || randomUnit >= 1)
+            throw new ArgumentOutOfRangeException(nameof(randomUnit));
+
+        // Bound the exponent; never overflow when recovering a malformed attempt count.
+        double cap = Math.Min(options.MaximumRetryDelay.TotalMilliseconds,
+            options.InitialRetryDelay.TotalMilliseconds * Math.Pow(2, Math.Min(failedAttempt - 1, 30)));
+        return TimeSpan.FromMilliseconds(cap * (0.5 + 0.5 * randomUnit));
+    }
+}
+
+public enum DeliveryDisposition { RetryableFailure, PermanentFailure }
+public sealed record DeliveryResult(bool Accepted, DeliveryDisposition FailureDisposition,
+    TimeSpan? RetryAfter = null, string? ProviderMessageId = null, string? ErrorCode = null)
+{
+    public static DeliveryResult Success(string? providerMessageId = null) =>
+        new(true, DeliveryDisposition.RetryableFailure, ProviderMessageId: providerMessageId);
+    public static DeliveryResult Retry() => new(false, DeliveryDisposition.RetryableFailure);
+    public static DeliveryResult Retry(TimeSpan retryAfter)
+    {
+        if (retryAfter <= TimeSpan.Zero || retryAfter > TimeSpan.FromDays(1))
+            throw new ArgumentOutOfRangeException(nameof(retryAfter));
+        return new(false, DeliveryDisposition.RetryableFailure, retryAfter);
+    }
+    public static DeliveryResult PermanentFailure(string? errorCode = null) =>
+        new(false, DeliveryDisposition.PermanentFailure, ErrorCode: errorCode);
+}
+
+public interface IOutboxSender
+{
+    // One message is ONE externally observable send, e.g. one channel + one recipient.
+    // Use Message.EventKey as the provider idempotency key whenever supported.
+    // Success means durable acceptance, not necessarily arrival at the recipient.
+    // Must observe cancellation and have its own bounded transport timeout.
+    Task<DeliveryResult> SendAsync(OutboxMessage message, CancellationToken cancellationToken);
+}
+
+public interface IOutboxStore
+{
+    Task<OutboxClaim?> ClaimAsync(CancellationToken cancellationToken);
+    Task<bool> CompleteAsync(OutboxClaim claim, string? providerMessageId, CancellationToken cancellationToken);
+    Task<bool> FailAsync(OutboxClaim claim, bool permanent, TimeSpan delay,
+        string safeErrorCode, CancellationToken cancellationToken);
+}
+
+public sealed record OutboxRunResult(int Claimed, int Accepted, int Failed, int LostLeases);
+
+/// <summary>
+/// Framework-independent runner; invoke from an ABP periodic worker or HostedService.
+/// Delivery is at-least-once: a crash after acceptance but before ack can cause a duplicate.
+/// </summary>
+public sealed class OutboxProcessor
+{
+    private readonly IOutboxStore _store;
+    private readonly IOutboxSender _sender;
+    private readonly OutboxOptions _options;
+
+    public OutboxProcessor(IOutboxStore store, IOutboxSender sender, OutboxOptions options)
+    {
+        _store = store ?? throw new ArgumentNullException(nameof(store));
+        _sender = sender ?? throw new ArgumentNullException(nameof(sender));
+        _options = options ?? throw new ArgumentNullException(nameof(options));
+        _options.Validate();
+    }
+
+    public async Task<OutboxRunResult> RunOnceAsync(int maximumMessages = 50,
+        CancellationToken cancellationToken = default)
+    {
+        if (maximumMessages is < 1 or > 1000)
+            throw new ArgumentOutOfRangeException(nameof(maximumMessages));
+        int claimed = 0, accepted = 0, failed = 0, lost = 0;
+        while (claimed < maximumMessages)
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            OutboxClaim? claim = await _store.ClaimAsync(cancellationToken);
+            if (claim is null) break;
+            claimed++;
+            DeliveryResult delivery;
+            string safeError = "PROVIDER_RETRYABLE_FAILURE";
+            using var timeout = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
+            timeout.CancelAfter(_options.SendTimeout);
+            try
+            {
+                delivery = await _sender.SendAsync(claim.Message, timeout.Token);
+                // Detect an invalid sender implementation while preserving the outgoing event.
+                if (delivery is null)
+                    throw new InvalidOperationException("Sender returned no delivery result.");
+                if (delivery.RetryAfter is { } retryAfter
+                    && (retryAfter <= TimeSpan.Zero || retryAfter > TimeSpan.FromDays(1)))
+                    throw new InvalidOperationException("Sender returned an invalid retry interval.");
+            }
+            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
+            {
+                // Leave the lease intact. Another worker recovers it after expiration.
+                throw;
+            }
+            catch (OperationCanceledException)
+            {
+                delivery = DeliveryResult.Retry();
+                safeError = "PROVIDER_TIMEOUT_OUTCOME_UNKNOWN";
+            }
+            catch (Exception)
+            {
+                // Do not persist exception messages: they can contain OTPs/phone numbers/tokens.
+                delivery = DeliveryResult.Retry();
+                safeError = "SENDER_EXCEPTION";
+            }
+
+            // DB acknowledgement failures intentionally propagate to the hosting worker's
+            // health/error handling; the lease later expires and makes recovery possible.
+            if (delivery.Accepted)
+            {
+                if (await _store.CompleteAsync(claim, delivery.ProviderMessageId, cancellationToken)) accepted++;
+                else lost++;
+            }
+            else
+            {
+                bool permanent = delivery.FailureDisposition == DeliveryDisposition.PermanentFailure;
+                if (permanent) safeError = delivery.ErrorCode ?? "PROVIDER_PERMANENT_FAILURE";
+                else if (delivery.ErrorCode != null) safeError = delivery.ErrorCode;
