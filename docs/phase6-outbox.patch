+                    delay = retryAfter;
+                if (await _store.FailAsync(claim, permanent, delay, safeError, cancellationToken)) failed++;
+                else lost++;
+            }
+        }
+        return new OutboxRunResult(claimed, accepted, failed, lost);
+    }
